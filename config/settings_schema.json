[
  {
    "name": "theme_info",
    "theme_name": "Teraclay",
    "theme_version": "1.0.0",
    "theme_author": "Teraclay",
    "theme_documentation_url": "https://github.com/DavidPrevost/site-design/tree/main/docs",
    "theme_support_url": "https://github.com/DavidPrevost/site-design"
  },
  {
    "name": "Logo and favicon",
    "settings": [
      {
        "type": "paragraph",
        "content": "With no logo image uploaded, the theme shows the Teraclay strata symbol next to the shop name."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Logo height",
        "min": 20,
        "max": 64,
        "step": 2,
        "unit": "px",
        "default": 30
      },
      {
        "type": "checkbox",
        "id": "show_wordmark",
        "label": "Show shop name next to the logo",
        "info": "Turn off if your logo image already includes the name.",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square image, at least 64 × 64 px. Defaults to the strata symbol."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#FBF6F0"
          },
          {
            "type": "color",
            "id": "surface",
            "label": "Cards and image backgrounds",
            "default": "#F4EBE1"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text and headings",
            "default": "#3B2E25"
          },
          {
            "type": "color",
            "id": "text_muted",
            "label": "Secondary text",
            "default": "#6A5E4D"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Links and labels",
            "default": "#9E5439"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Button",
            "default": "#9E5439"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Button label",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "border",
            "label": "Borders and dividers",
            "default": "#E8DCCF"
          }
        ],
        "role": {
          "background": "background",
          "text": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text",
          "links": "accent",
          "icons": "text"
        }
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Default pairing: Jost + Karla. Alternate: Josefin Sans (weight 600) + Work Sans."
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "jost_n5"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading size",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "karla_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Body text size",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Page width",
        "options": [
          { "value": "70rem", "label": "Narrow (1120 px)" },
          { "value": "75rem", "label": "Standard (1200 px)" },
          { "value": "90rem", "label": "Wide (1440 px)" }
        ],
        "default": "75rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "label": "Minimum side margin",
        "min": 12,
        "max": 60,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "select",
        "id": "button_shape",
        "label": "Button shape",
        "options": [
          { "value": "pill", "label": "Pill" },
          { "value": "rounded", "label": "Rounded" },
          { "value": "square", "label": "Square" }
        ],
        "default": "pill"
      },
      {
        "type": "range",
        "id": "card_radius",
        "label": "Card and image corner radius",
        "min": 0,
        "max": 36,
        "step": 2,
        "unit": "px",
        "default": 22
      },
      {
        "type": "range",
        "id": "input_radius",
        "label": "Form field corner radius",
        "min": 0,
        "max": 28,
        "step": 2,
        "unit": "px",
        "default": 14
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image shape",
        "options": [
          { "value": "square", "label": "Square" },
          { "value": "portrait", "label": "Portrait (4:5)" }
        ],
        "default": "portrait"
      },
      {
        "type": "select",
        "id": "card_image_fit",
        "label": "Image fit",
        "options": [
          { "value": "contain", "label": "Fit whole product" },
          { "value": "cover", "label": "Fill the frame" }
        ],
        "default": "contain"
      },
      {
        "type": "checkbox",
        "id": "card_show_badge",
        "label": "Show \"best for\" badge",
        "info": "Uses the product's \"Best for\" field (custom.best_for).",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_add",
        "label": "Show quick add button",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Show review stars",
        "info": "Stars appear once a product has reviews.",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "When a shopper adds to cart",
        "options": [
          { "value": "drawer", "label": "Open the cart drawer" },
          { "value": "page", "label": "Go to the cart page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Show order note field",
        "default": false
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "label": "Show product suggestions while typing",
        "default": true
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram_link", "label": "Instagram", "placeholder": "https://instagram.com/teraclay" },
      { "type": "text", "id": "social_facebook_link", "label": "Facebook", "placeholder": "https://facebook.com/teraclay" },
      { "type": "text", "id": "social_tiktok_link", "label": "TikTok" },
      { "type": "text", "id": "social_youtube_link", "label": "YouTube" },
      { "type": "text", "id": "social_x_link", "label": "X (Twitter)" },
      { "type": "text", "id": "social_pinterest_link", "label": "Pinterest" }
    ]
  },
  {
    "name": "Reviews",
    "settings": [
      {
        "type": "paragraph",
        "content": "Connects to the Teraclay reviews service. The widget is restyled to match this theme."
      },
      {
        "type": "checkbox",
        "id": "reviews_enabled",
        "label": "Show reviews",
        "default": true
      },
      {
        "type": "text",
        "id": "reviews_widget_url",
        "label": "Widget script URL",
        "default": "https://reviews.teraclay.com/widget.js"
      },
      {
        "type": "color",
        "id": "reviews_star_color",
        "label": "Star color",
        "default": "#B5694C"
      },
      {
        "type": "checkbox",
        "id": "reviews_send_theme_colors",
        "label": "Share theme colors with the reviews service",
        "info": "Its emails and review pages then use your brand colors.",
        "default": true
      }
    ]
  },
  {
    "name": "Affiliate program",
    "settings": [
      {
        "type": "checkbox",
        "id": "affiliates_enabled",
        "label": "Show affiliate program links",
        "default": true
      },
      {
        "type": "text",
        "id": "affiliates_portal_url",
        "label": "Affiliate dashboard URL",
        "default": "https://affiliates.teraclay.com/"
      },
      {
        "type": "page",
        "id": "affiliates_page",
        "label": "\"Become an affiliate\" page",
        "info": "A page that uses the \"affiliates\" template."
      },
      {
        "type": "text",
        "id": "affiliates_discount_label",
        "label": "Shopper discount",
        "default": "10%"
      },
      {
        "type": "checkbox",
        "id": "discount_banner_enabled",
        "label": "Show a banner when a discount link is used",
        "info": "For example promo.teraclay.com/NAME. The banner shows the applied code.",
        "default": true
      }
    ]
  }
]
