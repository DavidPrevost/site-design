<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    {% render 'meta-tags' %}

    {%- unless settings.type_heading_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}
    {%- unless settings.type_heading_font.system? -%}
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {%- endunless -%}
    {%- unless settings.type_body_font.system? -%}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {%- endunless -%}

    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}

    <script>
      document.documentElement.classList.replace('no-js', 'js');
    </script>

    <script>
      window.theme = {
        cartType: {{ settings.cart_type | json }},
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        strings: {
          cartError: {{ 'cart.error' | t | json }},
          cartLink: {{ 'general.cart_link' | t: count: '__COUNT__' | json }},
          addToCart: {{ 'product.add_to_cart' | t | json }},
          soldOut: {{ 'product.sold_out' | t | json }},
          unavailable: {{ 'product.unavailable' | t | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {%- if settings.reviews_enabled and settings.reviews_widget_url != blank -%}
      <script src="{{ settings.reviews_widget_url }}" defer></script>
    {%- endif -%}

    {% render 'structured-data' %}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}
    {% render 'discount-banner' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}
  </body>
</html>
