<section class="section color-{{ section.settings.color_scheme }}" style="--section-pt: 120px; --section-pb: 120px;">
  <div class="page-width not-found stack">
    {% render 'icon-mark', class: 'not-found__mark' %}
    <h1 class="h1">{{ '404.title' | t }}</h1>
    <p class="lead">{{ '404.not_found' | t }}</p>
    <div class="cluster">
      <a href="{{ routes.all_products_collection_url }}" class="button">{{ '404.back_to_shopping' | t }}</a>
      <button type="button" class="button button--secondary" data-open-search>{{ 'search.title' | t }}</button>
    </div>
  </div>
</section>

{% stylesheet %}
  .not-found {
    align-items: center;
    text-align: center;
  }

  .not-found__mark {
    width: 5rem;
    height: auto;
    margin-bottom: 0.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page not found",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
