<section class="section color-{{ section.settings.color_scheme }}" style="--section-pt: 72px; --section-pb: 104px;">
  <div class="page-width">
    <div class="section-header">
      <h1 class="h1">{{ blog.title | escape }}</h1>
    </div>
    {%- paginate blog.articles by 9 -%}
      <ul class="grid" role="list" style="--grid-desktop: 3;">
        {%- for article in blog.articles -%}
          <li>
            <a href="{{ article.url }}" class="article-card">
              {%- if article.image -%}
                <span class="media-rounded article-card__image">
                  {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw' }}
                </span>
              {%- endif -%}
              <span class="text-small text-muted">{{ article.published_at | time_tag: format: 'date' }}</span>
              <span class="h3">{{ article.title | escape }}</span>
              {%- if article.excerpt != blank -%}
                <span class="text-muted">{{ article.excerpt | strip_html | truncatewords: 24 }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% stylesheet %}
  .article-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    color: inherit;
    text-decoration: none;
  }

  .article-card__image {
    aspect-ratio: 3 / 2;
    margin-bottom: 0.375rem;
  }

  .article-card:hover .h3 {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
