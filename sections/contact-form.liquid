<section
  class="section contact-form color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width contact-form__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- form 'contact', id: 'ContactForm', class: 'contact-form__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'forms.sent' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="contact-form__fields">
        <div class="field">
          <label class="field__label" for="ContactForm-name">{{ 'forms.name' | t }}</label>
          <input class="input" id="ContactForm-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
        </div>
        <div class="field">
          <label class="field__label" for="ContactForm-email">{{ 'forms.email' | t }} <span aria-hidden="true">*</span></label>
          <input class="input" id="ContactForm-email" type="email" name="contact[email]" autocomplete="email" required aria-required="true" value="{{ form.email }}">
        </div>
        {%- if section.settings.show_phone -%}
          <div class="field">
            <label class="field__label" for="ContactForm-phone">{{ 'forms.phone' | t }}</label>
            <input class="input" id="ContactForm-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
          </div>
        {%- endif -%}
        <div class="field contact-form__full">
          <label class="field__label" for="ContactForm-body">{{ 'forms.message' | t }}</label>
          <textarea class="input" id="ContactForm-body" name="contact[body]" rows="6">{{ form.body }}</textarea>
        </div>
      </div>
      <button type="submit" class="button">{{ 'forms.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  .contact-form__inner {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 48rem;
  }

  .contact-form__form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .contact-form__fields {
    display: grid;
    width: 100%;
    gap: 1.25rem;
  }

  @media (min-width: 750px) {
    .contact-form__fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact-form__full {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "class": "section-contact-form",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Send us a message" },
    { "type": "checkbox", "id": "show_phone", "label": "Show phone field", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 }
  ],
  "presets": [
    { "name": "Contact form" }
  ]
}
{% endschema %}
