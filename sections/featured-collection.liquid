{%- liquid
  assign max = section.settings.max_products
  if section.settings.products != blank
    assign items = section.settings.products
  else
    assign items = section.settings.collection.products
  endif
  assign link_url = section.settings.link_url | default: section.settings.collection.url | default: routes.all_products_collection_url
-%}
<section
  class="section featured-collection color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="section-header">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="lead rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ link_url }}" class="link-arrow">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if items.size > 0 -%}
      <ul class="grid grid--scroll-mobile" role="list" style="--grid-desktop: {{ section.settings.columns }};">
        {%- for product in items limit: max -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <ul class="grid grid--scroll-mobile" role="list" style="--grid-desktop: {{ section.settings.columns }};">
        {%- for i in (1..3) -%}
          <li class="product-card">
            <div class="media-well" style="--media-ratio: 4 / 5;">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <p class="h3">Product name</p>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Shop" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The collection" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Three products, made from minerals and plants. Nothing extra.</p>" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "product_list", "id": "products", "label": "Or pick products", "info": "Overrides the collection.", "limit": 12 },
    { "type": "range", "id": "max_products", "label": "Maximum products", "min": 2, "max": 12, "step": 1, "default": 3 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "url", "id": "link_url", "label": "Link", "info": "Defaults to the collection." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 }
  ],
  "presets": [
    { "name": "Featured products" }
  ]
}
{% endschema %}
