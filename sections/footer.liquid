<footer class="footer color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="footer__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div class="footer__block footer__block--brand stack" {{ block.shopify_attributes }}>
              {% render 'logo' %}
              {%- if block.settings.text != blank -%}
                <div class="rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.contact != blank -%}
                <div class="rte text-small">{{ block.settings.contact }}</div>
              {%- endif -%}
              {%- if block.settings.show_social -%}
                {% render 'social-links' %}
              {%- endif -%}
            </div>

          {%- when 'menu' -%}
            <div class="footer__block" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="footer__links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a
                        href="{{ link.url }}"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{- link.title | escape -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

          {%- when 'affiliates' -%}
            {%- if settings.affiliates_enabled -%}
              <div class="footer__block" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                <ul class="footer__links" role="list">
                  {%- if settings.affiliates_page != blank -%}
                    <li>
                      <a href="{{ settings.affiliates_page.url }}">{{ 'footer.become_affiliate' | t }}</a>
                    </li>
                  {%- endif -%}
                  {%- if settings.affiliates_portal_url != blank -%}
                    <li>
                      <a href="{{ settings.affiliates_portal_url }}">{{ 'footer.affiliate_login' | t }}</a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.terms_page != blank -%}
                    <li>
                      <a href="{{ block.settings.terms_page.url }}">{{ 'footer.program_terms' | t }}</a>
                    </li>
                  {%- endif -%}
                </ul>
              </div>
            {%- endif -%}

          {%- when 'newsletter' -%}
            <div class="footer__block footer__block--wide stack" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="rte text-small">{{ block.settings.text }}</div>
              {%- endif -%}
              {% render 'newsletter-form', form_id: 'FooterNewsletter', button_class: 'button--small' %}
            </div>

          {%- when 'text' -%}
            <div class="footer__block stack" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              <div class="rte text-small">{{ block.settings.text }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      {%- assign current_year = 'now' | date: '%Y' -%}
      <p class="footer__copyright">
        {{- 'footer.copyright' | t: year: current_year, shop: shop.name -}}
      </p>

      {%- if shop.policies.size > 0 -%}
        <nav aria-label="{{ 'footer.policies' | t }}">
          <ul class="footer__policies" role="list">
            {%- for policy in shop.policies -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payment" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    padding-block: clamp(3rem, 6vw, 4.5rem) 2.5rem;
    background-color: var(--color-background);
    color: var(--color-muted);
  }

  .footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--color-foreground);
    text-decoration: underline;
  }

  .footer .logo {
    color: var(--color-foreground);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 2rem;
  }

  .footer__block--brand,
  .footer__block--wide {
    grid-column: 1 / -1;
    --stack-gap: 1.125rem;
  }

  @media (min-width: 990px) {
    .footer__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .footer__block--brand,
    .footer__block--wide {
      grid-column: span 2;
      padding-right: 3rem;
    }
  }

  .footer__heading {
    margin-bottom: 0.875rem;
    font-family: var(--font-body-family);
    font-size: 0.75rem;
    font-weight: var(--font-body-weight-bold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8125rem;
  }

  .footer__policies,
  .footer__payment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__payment {
    gap: 0.5rem;
  }

  .footer__payment-icon {
    width: 2.375rem;
    height: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Mineral-enriched natural skincare, straight from the earth.</p>"
        },
        {
          "type": "richtext",
          "id": "contact",
          "label": "Contact details",
          "default": "<p>info@teraclay.com<br/>73 Carol Place, Wayne, NJ 07470</p>"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social media icons",
          "default": true
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "affiliates",
      "name": "Affiliate links",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Links to your \"Become an affiliate\" page and the affiliate dashboard, set in Theme settings > Affiliate program."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Affiliates"
        },
        {
          "type": "page",
          "id": "terms_page",
          "label": "Program terms page"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Stay in touch"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>New products and subscriber-only offers.</p>"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share something about your brand.</p>"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "brand" },
        { "type": "menu" },
        { "type": "affiliates" }
      ]
    }
  ]
}
{% endschema %}
