{%- liquid
  assign ingredients = product.metafields.custom.key_ingredients.value
  assign made_without = product.metafields.custom.made_without.value
  assign ingredients_url = section.settings.ingredients_page.url
-%}
{%- if ingredients != blank or made_without != blank or section.blocks.size > 0 -%}
  <section
    class="section key-ingredients color-{{ section.settings.color_scheme }}"
    style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="page-width">
      <div class="section-header">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow eyebrow--plain">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        </div>
        {%- if ingredients_url != blank -%}
          <a href="{{ ingredients_url }}" class="link-arrow">{{ section.settings.link_label | escape }}</a>
        {%- endif -%}
      </div>

      <ul class="grid" role="list" style="--grid-desktop: 3;">
        {%- if ingredients != blank -%}
          {%- for ingredient in ingredients -%}
            {%- liquid
              assign url = blank
              if ingredients_url != blank
                assign url = ingredients_url | append: '#' | append: ingredient.system.handle
              endif
            -%}
            <li>
              {% render 'ingredient-card',
                name: ingredient.name.value,
                source: ingredient.source.value,
                description: ingredient.description.value,
                icon: ingredient.icon.value,
                image: ingredient.image.value,
                url: url,
                surface: 'background'
              %}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {% render 'ingredient-card',
                name: block.settings.name,
                source: block.settings.source,
                description: block.settings.description,
                icon: block.settings.icon,
                surface: 'background'
              %}
            </li>
          {%- endfor -%}
        {%- endif -%}

        {%- if made_without != blank -%}
          <li class="ingredient-card ingredient-card--background">
            <span class="h3 ingredient-card__name">{{ section.settings.made_without_heading | escape }}</span>
            <ul class="cluster" role="list" style="--cluster-gap: 0.5rem; padding: 0; list-style: none;">
              {%- for item in made_without -%}
                <li class="badge badge--outline">{{ item | escape }}</li>
              {%- endfor -%}
            </ul>
          </li>
        {%- endif -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Key ingredients",
  "class": "section-key-ingredients",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the product's \"Key ingredients\" (custom.key_ingredients) and \"Made without\" (custom.made_without) fields. Blocks below are used only when a product has no key ingredients set."
    },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "What’s inside" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Key ingredients" },
    { "type": "page", "id": "ingredients_page", "label": "Ingredients page" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See all ingredients" },
    { "type": "text", "id": "made_without_heading", "label": "\"Made without\" heading", "default": "Made without" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Ingredient" },
        { "type": "text", "id": "source", "label": "Source" },
        { "type": "textarea", "id": "description", "label": "Description" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "mineral", "label": "Mineral" },
            { "value": "drop", "label": "Drop" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "sprout", "label": "Sprout" }
          ],
          "default": "leaf"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Key ingredients"
    }
  ]
}
{% endschema %}
