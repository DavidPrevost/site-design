<section
  class="section color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="section-header">
      <h1 class="h1">{{ section.settings.heading | escape }}</h1>
    </div>
    {%- paginate collections by 24 -%}
      <ul class="grid" role="list" style="--grid-desktop: 3;">
        {%- for collection in collections -%}
          <li>
            <a href="{{ collection.url }}" class="collection-card">
              <span class="media-well media-well--blend" style="--media-ratio: 4 / 3;">
                {%- if collection.featured_image -%}
                  {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: '' }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </span>
              <span class="h3">{{ collection.title | escape }}</span>
              <span class="text-small text-muted">{{ 'collections.product_count' | t: count: collection.products_count }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% stylesheet %}
  .collection-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    color: inherit;
    text-decoration: none;
  }

  .collection-card:hover .h3 {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 }
  ],
  "enabled_on": {
    "templates": ["list-collections"]
  }
}
{% endschema %}
