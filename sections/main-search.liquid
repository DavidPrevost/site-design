<section
  class="section main-search color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="section-header section-header--center">
      <h1 class="h1">{{ 'search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form main-search__form">
        <label class="visually-hidden" for="MainSearchInput">{{ 'search.title' | t }}</label>
        {% render 'icon', name: 'search', class: 'search-form__icon' %}
        <input
          id="MainSearchInput"
          class="search-form__input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="button button--small main-search__submit">{{ 'search.submit' | t }}</button>
      </form>
      {%- if search.performed -%}
        <p class="text-muted" role="status">
          {%- if search.results_count == 0 -%}
            {{ 'search.no_results_html' | t: terms: search.terms }}
          {%- else -%}
            {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    {%- if search.performed and search.results_count > 0 -%}
      {%- paginate search.results by 24 -%}
        {%- if search.filters.size > 0 -%}
          {% render 'facets', results: search, results_url: routes.search_url, terms: search.terms %}
        {%- endif -%}
        <ul class="grid" role="list" style="--grid-desktop: 3;">
          {%- for result in search.results -%}
            <li>
              {%- if result.object_type == 'product' -%}
                {% render 'product-card', product: result %}
              {%- else -%}
                <a href="{{ result.url }}" class="search-result card card--bordered card--padded">
                  <span class="eyebrow">{{ result.object_type | capitalize }}</span>
                  <span class="h3">{{ result.title | escape }}</span>
                  <span class="text-small text-muted">{{ result.content | strip_html | truncatewords: 24 }}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .main-search__form {
    width: min(40rem, 100%);
  }

  .main-search__submit {
    position: absolute;
    right: 0.375rem;
  }

  .main-search .search-form__input {
    padding-right: 7rem;
  }

  .search-result {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Search results",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 }
  ],
  "enabled_on": {
    "templates": ["search"]
  }
}
{% endschema %}
