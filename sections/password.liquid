<div class="password color-{{ section.settings.color_scheme }}">
  <div class="password__card stack">
    {% render 'icon-mark', class: 'password__mark' %}
    <p class="h2">{{ shop.name | escape }}</p>
    <h1 class="eyebrow">{{ 'password.title' | t }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="lead">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'password__form' -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label for="PasswordInput" class="visually-hidden">{{ 'password.password' | t }}</label>
      <div class="inline-form inline-form--stack-mobile">
        <input
          class="input input--pill"
          type="password"
          name="password"
          id="PasswordInput"
          autocomplete="current-password"
          placeholder="{{ 'password.password' | t }}"
        >
        <button type="submit" class="button">{{ 'password.enter' | t }}</button>
      </div>
    {%- endform -%}

    <p class="text-small text-muted">
      {{ 'password.store_owner' | t }}
      <a href="/admin">{{ 'password.log_in' | t }}</a>
    </p>
  </div>
</div>

{% stylesheet %}
  .password {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 2rem var(--page-margin);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .password__card {
    align-items: center;
    max-width: 30rem;
    text-align: center;
  }

  .password__mark {
    width: 5rem;
    height: auto;
  }

  .password__form {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ]
}
{% endschema %}
