{% comment %}
  Rendered by /search/suggest?section_id=predictive-search from assets/theme.js.
{% endcomment %}
{%- if predictive_search.performed -%}
  {%- liquid
    assign resources = predictive_search.resources
    assign total = resources.products.size | plus: resources.pages.size | plus: resources.articles.size | plus: resources.collections.size
  -%}
  <div class="predictive-search">
    {%- if total == 0 -%}
      <p class="text-muted">{{ 'search.no_results_html' | t: terms: predictive_search.terms }}</p>
    {%- else -%}
      <div class="predictive-search__groups">
        {%- if resources.products.size > 0 -%}
          <div class="predictive-search__group predictive-search__group--products">
            <h2 class="eyebrow">{{ 'search.products' | t }}</h2>
            <ul class="predictive-search__products" role="list">
              {%- for product in resources.products -%}
                <li>
                  <a href="{{ product.url }}" class="predictive-search__product">
                    <span class="media-well media-well--contain media-well--blend predictive-search__thumb">
                      {%- if product.featured_image -%}
                        {{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                      {%- endif -%}
                    </span>
                    <span class="predictive-search__product-text">
                      <span class="predictive-search__title">{{ product.title | escape }}</span>
                      <span class="text-small text-muted">{% render 'price', product: product, plain: true %}</span>
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if resources.collections.size > 0 or resources.pages.size > 0 or resources.articles.size > 0 -%}
          <div class="predictive-search__group">
            <h2 class="eyebrow">{{ 'search.pages' | t }}</h2>
            <ul class="predictive-search__links" role="list">
              {%- for collection in resources.collections -%}
                <li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
              {%- endfor -%}
              {%- for page in resources.pages -%}
                <li><a href="{{ page.url }}">{{ page.title | escape }}</a></li>
              {%- endfor -%}
              {%- for article in resources.articles -%}
                <li><a href="{{ article.url }}">{{ article.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <a class="link-arrow predictive-search__all" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options%5Bprefix%5D=last">
      {{- 'search.search_for_html' | t: terms: predictive_search.terms -}}
    </a>
  </div>
{%- endif -%}

{% stylesheet %}
  .predictive-search {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .predictive-search__groups {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 750px) {
    .predictive-search__groups {
      grid-template-columns: 2fr 1fr;
    }
  }

  .predictive-search__products,
  .predictive-search__links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .predictive-search__product {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.375rem;
    border-radius: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .predictive-search__product:hover {
    background-color: var(--color-surface);
  }

  .predictive-search__thumb {
    --media-ratio: 1;
    width: 3.5rem;
    flex-shrink: 0;
    border-radius: 0.625rem;
  }

  .predictive-search__product-text {
    display: flex;
    flex-direction: column;
  }

  .predictive-search__title {
    font-weight: var(--font-body-weight-bold);
  }

  .predictive-search__links a {
    color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Predictive search",
  "settings": []
}
{% endschema %}
