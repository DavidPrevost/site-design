{%- assign products = section.settings.products -%}
<section
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id | handle }}"
  {% endif %}
  class="section product-compare color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="section-header">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="lead rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>

    <ul class="grid product-compare__grid" role="list" style="--grid-desktop: {{ products.size | at_least: 2 | at_most: 3 }};">
      {%- for product in products -%}
        {%- assign best_for = product.metafields.custom.best_for.value -%}
        <li class="product-compare__card card card--bordered">
          <div class="product-compare__top">
            <a href="{{ product.url }}" class="media-well media-well--contain media-well--blend product-compare__media" tabindex="-1" aria-hidden="true">
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 400 | image_tag: loading: 'lazy', alt: '', widths: '200, 400', sizes: '10rem' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="product-compare__title stack" style="--stack-gap: 0.375rem;">
              {%- if best_for != blank -%}
                <p class="eyebrow eyebrow--plain text-muted">{{ 'product.best_for' | t }}</p>
                <p class="h2 product-compare__best-for">{{ best_for | escape }}</p>
              {%- endif -%}
              <h3 class="product-compare__name">{{ product.title | escape }}</h3>
            </div>
          </div>

          <dl class="product-compare__rows">
            {%- for block in section.blocks -%}
              {%- capture value -%}
                {%- render 'metafield-value', resource: product, key: block.settings.metafield, inline: true -%}
              {%- endcapture -%}
              {%- if value != blank -%}
                <div class="product-compare__row" {{ block.shopify_attributes }}>
                  <dt>{{ block.settings.label | escape }}</dt>
                  <dd>{{ value }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>

          <a href="{{ product.url }}" class="button button--secondary product-compare__link">
            {{- 'product.view_product' | t: product: product.title | escape -}}
          </a>
        </li>
      {%- else -%}
        <li class="card card--bordered card--padded">
          <p class="text-muted">Pick two or three products in this section's settings to compare them.</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .product-compare__card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .product-compare__top {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .product-compare__media {
    --media-ratio: 15 / 17;
    width: clamp(6.5rem, 20vw, 9.5rem);
    flex-shrink: 0;
  }

  .product-compare__best-for {
    font-size: calc(var(--font-heading-scale) * clamp(1.375rem, 1.1rem + 0.9vw, 1.875rem));
  }

  .product-compare__name {
    font-family: var(--font-body-family);
    font-weight: var(--font-body-weight);
    font-size: 1rem;
    letter-spacing: 0;
    color: var(--color-muted);
  }

  .product-compare__rows {
    margin: 0;
    border-bottom: 1px solid var(--color-border);
  }

  .product-compare__row {
    display: grid;
    gap: 0.25rem 1rem;
    padding-block: 0.875rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
  }

  @media (min-width: 750px) {
    .product-compare__row {
      grid-template-columns: 9.5rem minmax(0, 1fr);
    }
  }

  .product-compare__row dt {
    font-weight: var(--font-body-weight-bold);
  }

  .product-compare__row dd {
    margin: 0;
  }

  .product-compare__link {
    align-self: flex-start;
    margin-top: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product comparison",
  "class": "section-product-compare",
  "settings": [
    {
      "type": "paragraph",
      "content": "Compares products side by side using their product fields. Each row shows one field, for example custom.best_for."
    },
    { "type": "text", "id": "anchor_id", "label": "Section link id", "info": "Link to this section with /#compare.", "default": "compare" },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Two creams, two skin types" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Which cream is right for you?" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A plain comparison, so you can choose the one your skin actually needs. Questions? Email us at info@teraclay.com.</p>"
    },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 104 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Key ingredients" },
        {
          "type": "text",
          "id": "metafield",
          "label": "Product field",
          "info": "Namespace and key, for example custom.scent.",
          "default": "custom.key_ingredients"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product comparison",
      "blocks": [
        { "type": "row", "settings": { "label": "Key ingredients", "metafield": "custom.key_ingredients" } },
        { "type": "row", "settings": { "label": "Made without", "metafield": "custom.made_without" } },
        { "type": "row", "settings": { "label": "Feel", "metafield": "custom.feel" } },
        { "type": "row", "settings": { "label": "Scent", "metafield": "custom.scent" } }
      ]
    }
  ]
}
{% endschema %}
