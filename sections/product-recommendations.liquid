{%- liquid
  assign picked = section.settings.products
  assign max = section.settings.max_products
  assign count = 0
-%}
<section
  class="section product-recommendations color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    {%- if picked != blank -%}
      <ul class="grid grid--scroll-mobile" role="list" style="--grid-desktop: 3;">
        {%- for item in picked -%}
          {%- if item.id != product.id and count < max -%}
            {%- assign count = count | plus: 1 -%}
            <li>
              {%- assign note = item.metafields.custom.pairing_note.value -%}
              {% render 'product-card', product: item, note: note %}
            </li>
          {%- endif -%}
        {%- endfor -%}
        {%- render 'compare-card', options: section.settings -%}
      </ul>
    {%- else -%}
      <product-recommendations
        data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ max }}&intent={{ section.settings.intent }}"
      >
        {%- if recommendations.performed and recommendations.products_count > 0 -%}
          <ul class="grid grid--scroll-mobile" role="list" style="--grid-desktop: 3;">
            {%- for item in recommendations.products -%}
              <li>
                {%- assign note = item.metafields.custom.pairing_note.value -%}
                {% render 'product-card', product: item, note: note %}
              </li>
            {%- endfor -%}
            {%- render 'compare-card', options: section.settings -%}
          </ul>
        {%- endif -%}
      </product-recommendations>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Also from Teraclay",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Also from Teraclay"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "info": "The product being viewed is skipped automatically. Leave empty to use Shopify's recommendations. Each card shows the product's \"Pairing note\" field.",
      "limit": 6
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Shopify recommendation type",
      "info": "Used only when no products are picked above.",
      "options": [
        { "value": "complementary", "label": "Goes well with" },
        { "value": "related", "label": "Similar products" }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Link card"
    },
    {
      "type": "checkbox",
      "id": "show_compare_card",
      "label": "Show a link card after the products",
      "default": true
    },
    {
      "type": "text",
      "id": "compare_eyebrow",
      "label": "Label",
      "default": "Not sure?"
    },
    {
      "type": "text",
      "id": "compare_heading",
      "label": "Heading",
      "default": "Compare our two creams"
    },
    {
      "type": "textarea",
      "id": "compare_text",
      "label": "Text",
      "default": "See skin type, ingredients and scent side by side, then pick the one that suits you."
    },
    {
      "type": "text",
      "id": "compare_link_label",
      "label": "Link label",
      "default": "Compare creams"
    },
    {
      "type": "url",
      "id": "compare_link",
      "label": "Link",
      "default": "/"
    },
    {
      "type": "color_scheme",
      "id": "compare_color_scheme",
      "label": "Link card color scheme",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 104
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Also from Teraclay"
    }
  ]
}
{% endschema %}
