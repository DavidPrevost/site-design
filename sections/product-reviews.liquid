{%- if settings.reviews_enabled -%}
  <section
    id="ProductReviews"
    class="section product-reviews color-{{ section.settings.color_scheme }}"
    style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <div class="section-header">
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        </div>
      {%- endif -%}
      {% render 'reviews-widget', product: product, mode: 'full' %}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product reviews",
  "class": "section-product-reviews",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows reviews from the Teraclay reviews service. Turn reviews on or off in Theme settings > Reviews."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the widget's own heading."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Product reviews"
    }
  ]
}
{% endschema %}
