{% doc %}
  One line item in the cart drawer or on the cart page.

  @param {object} item - The line item
  @param {number} index - 1-based line number (used by /cart/change.js)
{% enddoc %}
<li class="cart-line" data-line="{{ index }}">
  <a href="{{ item.url }}" class="cart-line__media media-well media-well--contain media-well--blend" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', widths: '120, 240', sizes: '96px' }}
    {%- endif -%}
  </a>
  <div class="cart-line__info">
    <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title | escape }}</a>
    {%- unless item.product.has_only_default_variant -%}
      <p class="text-small text-muted">{{ item.variant.title | escape }}</p>
    {%- endunless -%}
    {%- for property in item.properties -%}
      {%- assign first_char = property.first | slice: 0 -%}
      {%- if property.last != blank and first_char != '_' -%}
        <p class="text-small text-muted">{{ property.first | escape }}: {{ property.last | escape }}</p>
      {%- endif -%}
    {%- endfor -%}
    {%- if item.selling_plan_allocation -%}
      <p class="text-small text-muted">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
    {%- endif -%}
    {%- for allocation in item.line_level_discount_allocations -%}
      <p class="badge badge--accent">
        {%- render 'icon', name: 'tag', size: 14 -%}
        {{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money }})
      </p>
    {%- endfor -%}

    <div class="cart-line__row">
      <quantity-input class="quantity quantity--small">
        <button type="button" class="quantity__button" name="minus" aria-label="{{ 'cart.decrease_quantity' | t: product: item.product.title | escape }}">−</button>
        <input
          class="quantity__input"
          type="number"
          name="updates[]"
          value="{{ item.quantity }}"
          min="0"
          aria-label="{{ 'cart.quantity' | t }}"
          data-line="{{ index }}"
        >
        <button type="button" class="quantity__button" name="plus" aria-label="{{ 'cart.increase_quantity' | t: product: item.product.title | escape }}">+</button>
      </quantity-input>
      <div class="cart-line__price">
        {%- if item.original_line_price != item.final_line_price -%}
          <s class="price__compare">{{ item.original_line_price | money }}</s>
        {%- endif -%}
        <span>{{ item.final_line_price | money }}</span>
      </div>
    </div>
    <a
      href="{{ item.url_to_remove }}"
      class="cart-line__remove text-small"
      data-remove-line="{{ index }}"
      aria-label="{{ 'cart.remove_item' | t: product: item.product.title | escape }}"
    >
      {{- 'cart.remove' | t -}}
    </a>
  </div>
</li>

{% stylesheet %}
  .cart-lines {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cart-line {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.125rem;
    border-bottom: 1px solid var(--color-border);
  }

  .cart-line:first-child {
    padding-top: 0;
  }

  .cart-line__media {
    --media-ratio: 4 / 5;
    border-radius: calc(var(--radius-card) * 0.6);
  }

  .cart-line__info {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }

  .cart-line__title {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 1.0625rem;
    line-height: 1.25;
    color: inherit;
    text-decoration: none;
  }

  .cart-line__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.375rem;
  }

  .cart-line__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-weight: var(--font-body-weight-bold);
  }

  .cart-line__remove {
    align-self: flex-start;
    color: var(--color-muted);
  }
{% endstylesheet %}
