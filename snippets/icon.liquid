{% doc %}
  Renders a named inline SVG icon. Stroke icons use currentColor.

  @param {string} name - Icon name: search, account, cart, menu, close, plus, minus,
    chevron-down, chevron-left, chevron-right, arrow-right, leaf, mineral, shield, check,
    drop, sprout, tag, chart, mail, star, instagram, facebook, tiktok, youtube, x, pinterest
  @param {number} [size] - Size in px (default 22)
  @param {string} [class] - Extra classes

  @example
  {% render 'icon', name: 'search', size: 20 %}
{% enddoc %}
{%- assign size = size | default: 22 -%}
<svg
  class="icon icon--{{ name }} {{ class }}"
  width="{{ size }}"
  height="{{ size }}"
  viewBox="0 0 24 24"
  style="--icon-size: {{ size }}px;"
  aria-hidden="true"
  focusable="false"
  {% if name == 'star' or name == 'facebook' or name == 'tiktok' or name == 'youtube' or name == 'pinterest' %}
    fill="currentColor"
  {% else %}
    fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
  {% endif %}
>
  {%- case name -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>
    {%- when 'cart' -%}
      <path d="M5 8h14l-1 13H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h10"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'chevron-down' -%}
      <path d="M6 9l6 6 6-6"/>
    {%- when 'chevron-left' -%}
      <path d="M15 6l-6 6 6 6"/>
    {%- when 'chevron-right' -%}
      <path d="M9 6l6 6-6 6"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-14 15-15-1 10-7 15-15 15z"/><path d="M5 19l7-7"/>
    {%- when 'mineral' -%}
      <path d="M12 2.5l8.2 4.75v9.5L12 21.5l-8.2-4.75v-9.5z"/><path d="M12 8l3.5 2v4L12 16l-3.5-2v-4z"/>
    {%- when 'shield' -%}
      <path d="M12 21s-7-4.5-7-10V5l7-2.5L19 5v6c0 5.5-7 10-7 10z"/>
    {%- when 'check' -%}
      <path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'drop' -%}
      <path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>
    {%- when 'sprout' -%}
      <path d="M12 21V11"/><path d="M12 11c0-4 3-7 7-7 0 4-3 7-7 7z"/><path d="M12 14c0-3-2.5-5.5-6-5.5 0 3 2.5 5.5 6 5.5z"/>
    {%- when 'tag' -%}
      <path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>
    {%- when 'chart' -%}
      <path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
    {%- when 'star' -%}
      <path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z"/>
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="0.6" fill="currentColor"/>
    {%- when 'facebook' -%}
      <path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4a21 21 0 0 0-2.3-.1c-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1z"/>
    {%- when 'tiktok' -%}
      <path d="M16.6 3c.3 2.2 1.6 3.6 3.9 3.8v3a7.3 7.3 0 0 1-3.9-1.2v6.2c0 3.4-2.4 6.2-6 6.2a6 6 0 0 1-6.1-6c0-3.6 3-6.2 6.6-5.9v3.2c-1.7-.3-3.3.9-3.3 2.7 0 1.5 1.2 2.8 2.8 2.8 1.8 0 2.8-1.3 2.8-3V3h3.2z"/>
    {%- when 'youtube' -%}
      <path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3L10 15z"/>
    {%- when 'x' -%}
      <path d="M4 4l16 16M20 4L4 20"/>
    {%- when 'pinterest' -%}
      <path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.5 2.2-.8 3.4-.2 1 .5 1.8 1.5 1.8 1.8 0 3.2-1.9 3.2-4.6 0-2.4-1.7-4.1-4.2-4.1-2.9 0-4.5 2.1-4.5 4.4 0 .9.3 1.8.8 2.3.1.1.1.2.1.3l-.3 1.2c0 .2-.2.3-.4.2-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.9-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2.1-1.3 2.8A10 10 0 1 0 12 2z"/>
  {%- endcase -%}
</svg>
