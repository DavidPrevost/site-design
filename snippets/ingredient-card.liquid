{% doc %}
  A single ingredient card.

  @param {string} name - Ingredient name
  @param {string} [source] - Where it comes from
  @param {string} [description] - What it does (plain text or HTML)
  @param {string} [icon] - mineral, drop, leaf or sprout
  @param {image} [image] - Optional image shown instead of the icon
  @param {string} [url] - Makes the card a link
  @param {string} [anchor] - id for linking to this card
  @param {string} [surface] - "white" (default) or "background"
{% enddoc %}
{%- liquid
  assign icon = icon | default: 'leaf'
  case icon
    when 'mineral'
      assign circle = 'icon-circle--mist'
    when 'drop'
      assign circle = 'icon-circle--peach'
    when 'sprout'
      assign circle = 'icon-circle--blush'
    else
      assign circle = 'icon-circle--sage'
  endcase
  if url != blank
    assign tag = 'a'
  else
    assign tag = 'div'
  endif
-%}
<{{ tag }}
  class="ingredient-card ingredient-card--{{ surface | default: 'white' }}"
  {% if url != blank %}
    href="{{ url }}"
  {% endif %}
  {% if anchor != blank %}
    id="{{ anchor }}"
  {% endif %}
>
  {%- if image != blank -%}
    <span class="ingredient-card__image media-rounded">
      {{ image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '', widths: '200, 400' }}
    </span>
  {%- else -%}
    <span class="icon-circle {{ circle }}">{% render 'icon', name: icon, size: 24 %}</span>
  {%- endif -%}
  <span class="h3 ingredient-card__name">{{ name | escape }}</span>
  {%- if source != blank -%}
    <span class="ingredient-card__source">{{ source | escape }}</span>
  {%- endif -%}
  {%- if description != blank -%}
    <span class="ingredient-card__description">{{ description }}</span>
  {%- endif -%}
</{{ tag }}>

{% stylesheet %}
  .ingredient-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    padding: 1.875rem 1.75rem;
    border-radius: var(--radius-card);
    color: var(--color-foreground);
    text-decoration: none;
  }

  .ingredient-card--white {
    background-color: color-mix(in srgb, var(--color-background) 25%, #fff);
    border: 1px solid var(--color-border);
  }

  .ingredient-card--background {
    background-color: var(--color-surface);
  }

  a.ingredient-card:hover .ingredient-card__name {
    text-decoration: underline;
  }

  .ingredient-card__name {
    font-size: calc(var(--font-heading-scale) * 1.375rem);
  }

  .ingredient-card__source {
    font-size: 0.75rem;
    font-weight: var(--font-body-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .ingredient-card__description {
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .ingredient-card__image {
    width: 4.5rem;
    height: 4.5rem;
  }
{% endstylesheet %}
