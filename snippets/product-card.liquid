{% doc %}
  Product card used in grids, recommendations and search results.

  @param {product} product - The product
  @param {string} [note] - Optional one-line note under the price (e.g. a pairing note)
  @param {string} [sizes] - The image `sizes` attribute
  @param {boolean} [eager] - Load the image eagerly (for cards above the fold)

  @example
  {% render 'product-card', product: product %}
{% enddoc %}
{%- liquid
  assign sizes = sizes | default: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 72vw'
  if settings.card_image_ratio == 'square'
    assign ratio = '1'
  else
    assign ratio = '4 / 5'
  endif
  assign fit_class = 'media-well--blend'
  if settings.card_image_fit == 'contain'
    assign fit_class = 'media-well--contain media-well--blend'
  endif
  assign best_for = product.metafields.custom.best_for.value
  assign subtitle = product.metafields.custom.eyebrow.value
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif
-%}
<div class="product-card">
  <a
    href="{{ product.url }}"
    class="product-card__media media-well {{ fit_class }}"
    style="--media-ratio: {{ ratio }};"
    tabindex="-1"
    aria-hidden="true"
  >
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 900
        | image_tag: loading: loading, widths: '300, 450, 600, 900', sizes: sizes, alt: ''
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}

    {%- if product.available == false -%}
      <span class="badge badge--light product-card__badge">{{ 'product.sold_out' | t }}</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="badge badge--solid product-card__badge">{{ 'product.sale' | t }}</span>
    {%- elsif settings.card_show_badge and best_for != blank -%}
      <span class="badge badge--light product-card__badge">{{ best_for | escape }}</span>
    {%- endif -%}
  </a>

  <div class="product-card__info">
    <div class="product-card__text">
      <h3 class="product-card__title">
        <a href="{{ product.url }}">{{ product.title | escape }}</a>
      </h3>
      {%- if subtitle != blank -%}
        <p class="product-card__subtitle">{{ subtitle | escape }}</p>
      {%- endif -%}
      {%- if settings.card_show_rating -%}
        {% render 'reviews-widget', product: product, mode: 'aggregate' %}
      {%- endif -%}
      <div class="product-card__price">{% render 'price', product: product, show_from: true %}</div>
      {%- if note != blank -%}
        <p class="product-card__note">{{ note | escape }}</p>
      {%- endif -%}
    </div>

    {%- if settings.card_show_quick_add and product.available -%}
      {%- if product.has_only_default_variant -%}
        <product-form class="product-card__quick-add">
          {%- form 'product', product -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button
              type="submit"
              class="icon-button icon-button--outline"
              aria-label="{{ 'product.quick_add' | t: product: product.title | escape }}"
            >
              {%- render 'icon', name: 'plus', size: 18 -%}
            </button>
          {%- endform -%}
        </product-form>
      {%- else -%}
        <a
          href="{{ product.url }}"
          class="icon-button icon-button--outline product-card__quick-add"
          aria-label="{{ 'product.view_product' | t: product: product.title | escape }}"
        >
          {%- render 'icon', name: 'arrow-right', size: 18 -%}
        </a>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .product-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
  }

  .product-card__media {
    display: flex;
  }

  .product-card__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
  }

  .product-card__info {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .product-card__text {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }

  .product-card__title {
    font-size: calc(var(--font-heading-scale) * 1.3125rem);
    line-height: 1.25;
    letter-spacing: -0.005em;
  }

  .product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .product-card__title a:hover {
    text-decoration: underline;
  }

  .product-card__subtitle,
  .product-card__note {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .product-card__note {
    margin-top: 0.25rem;
    line-height: 1.55;
  }

  .product-card__price {
    font-size: 1rem;
  }

  .product-card__quick-add {
    flex-shrink: 0;
  }

  /* Reserve space for aggregate stars so cards don't jump when they load. */
  .product-card .tc-reviews--aggregate {
    min-height: 1.25rem;
  }
{% endstylesheet %}
